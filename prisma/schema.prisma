generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Gender {
  FEMALE
  MALE
}

enum RoleModule {
  BOOTH
  HALL
}

enum ShiftType {
  BOOTH_SETUP
  BOOTH_DAY
  BOOTH_NIGHT
  BOOTH_PACKUP
}

enum AssignmentSource {
  AUTO
  MANUAL
}

enum AbsenceReason {
  NO_SHOW
  SICK
  EXCUSED
  OTHER
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum VolunteerStatus {
  PENDING
  VERIFIED
}

enum VerificationMethod {
  EMAIL
  SMS
}

enum LanguagePreference {
  ENGLISH
  SPANISH
  BOTH
}

enum OrientationRsvp {
  WILL_ATTEND
  WILL_NOT_ATTEND
}

// Silent sign-up flags — stored at submission time, never shown to the
// volunteer and never blocking. Surfaced to schedulers/supervisors.
enum FlagType {
  GENDER_MISMATCH
  AGE_UNDER_16
  AGE_16_18_NO_CONSENT
  LIFTING_MISMATCH
  STANDING_MISMATCH
}

enum NoteCategory {
  EXCELLENT
  NEEDS_GUIDANCE
  CALLOUT_HISTORY
  PHYSICAL_LIMITATION
  LANGUAGE_ONLY_SPANISH
  VIP_RETURN
  DO_NOT_SCHEDULE
  GENERAL
}

model Volunteer {
  id                   String    @id @default(cuid())
  // Sequential number behind the public Volunteer ID (SC2027000001).
  seq                  Int       @unique @default(autoincrement())
  volunteerCode        String?   @unique
  firstName            String
  lastName             String
  dob                  DateTime
  ageConfirmed         Boolean   @default(false)
  email                String
  phone                String
  address              String    @default("")
  emergencyContactName String
  emergencyContactPhone String
  gender               Gender
  language             LanguagePreference @default(ENGLISH)
  firstTimeVolunteer   Boolean   @default(false)
  orientationRsvp      OrientationRsvp?
  parentConsent        Boolean   @default(false)
  // Emergency/on-call volunteer opt-in: dates (yyyy-MM-dd) they can be called.
  emergencyOptIn       Boolean   @default(false)
  emergencyDates       String[]  @default([])
  textOk               Boolean   @default(false)
  emailOk              Boolean   @default(true)
  // Legacy score: confirmed prior years of participation. Autofill tiebreaker.
  yearsExperience      Int       @default(0)
  willingAnyBoothDay   Boolean   @default(false)
  willingAnyBoothNight Boolean   @default(false)
  status               VolunteerStatus @default(PENDING)
  verificationMethod   VerificationMethod @default(EMAIL)
  verifiedAt           DateTime?
  adminNotes           String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  acknowledgement VolunteerAcknowledgement?
  availabilities  Availability[]
  preferences     Preference[]
  trainings       Training[]
  approvals       Approval[]
  assignments     Assignment[]
  reminderLogs    ReminderLog[]
  flags           VolunteerFlag[]
  notes           AdminNote[]

  @@index([lastName, firstName])
  @@unique([email])
}

model VolunteerAcknowledgement {
  id                   String  @id @default(cuid())
  volunteerId          String  @unique
  age18Plus            Boolean
  standingWalking      Boolean
  heavyLift50          Boolean
  // Declared lifting capacity in pounds: 0, 25, or 50.
  liftingCapacityLbs   Int     @default(0)
  cashHandling         Boolean
  outdoorSun           Boolean
  liabilityAcknowledged Boolean
  foodRulesAcknowledged Boolean
  createdAt            DateTime @default(now())

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
}

model VolunteerFlag {
  id          String   @id @default(cuid())
  volunteerId String
  type        FlagType
  positionKey String?
  detail      String?
  createdAt   DateTime @default(now())

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId])
}

model AdminNote {
  id          String       @id @default(cuid())
  volunteerId String
  category    NoteCategory @default(GENERAL)
  text        String       @db.Text
  author      String
  // Private supervisor notes are only visible to their author (and admins can
  // see they exist). Shared notes are visible to schedulers and up.
  isPrivate   Boolean      @default(false)
  createdAt   DateTime     @default(now())

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId, createdAt])
}

model Event {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  shifts    Shift[]
}

model Shift {
  id                String    @id @default(cuid())
  eventId           String
  date              DateTime
  shiftType         ShiftType
  module            RoleModule
  label             String
  startAt           DateTime
  endAt             DateTime
  arrivalAt         DateTime?
  conflictStartAt   DateTime
  conflictEndAt     DateTime
  createdAt         DateTime  @default(now())

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  availabilities Availability[]
  preferences  Preference[]
  assignments  Assignment[]
  roleTargets  RoleTarget[]
  reminderLogs ReminderLog[]
  notes        ShiftNote[]
  publish      SchedulePublish?

  @@unique([date, shiftType])
  @@index([date, module])
}

model Role {
  id                String   @id @default(cuid())
  key               String   @unique
  name              String
  module            RoleModule
  description       String
  physicalDemands   String   @default("")
  requiresStanding  Boolean  @default(false)
  requiresHeavyLift Boolean  @default(false)
  // Lifting requirement in pounds (0 = none, 25 = some lifting, 50 = heavy).
  liftLimitLbs      Int      @default(0)
  minAge            Int      @default(16)
  requiresCash      Boolean  @default(false)
  requiresOutdoor   Boolean  @default(false)
  requiresTraining  Boolean  @default(false)
  requiresApproval  Boolean  @default(false)
  requiredGender    Gender?
  manualOnly        Boolean  @default(false)
  isRelief          Boolean  @default(false)
  // Hall positions: informational only — volunteers call the contact person.
  infoOnly          Boolean  @default(false)
  contactName       String?
  contactPhone      String?
  contactNote       String?
  urgent            Boolean  @default(false)

  preferences Preference[]
  trainings   Training[]
  approvals   Approval[]
  assignments Assignment[]
  targets     RoleTarget[]
}

model Availability {
  id          String   @id @default(cuid())
  volunteerId String
  shiftId     String
  createdAt   DateTime @default(now())

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  shift     Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, shiftId])
  @@index([shiftId])
}

model Preference {
  id          String   @id @default(cuid())
  volunteerId String
  shiftId     String
  roleId      String
  rank        Int
  createdAt   DateTime @default(now())

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  shift     Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, shiftId, roleId])
  @@index([shiftId, roleId])
}

model Training {
  id          String   @id @default(cuid())
  volunteerId String
  roleId      String
  trained     Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, roleId])
}

model Approval {
  id          String   @id @default(cuid())
  volunteerId String
  roleId      String
  approved    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, roleId])
}

model Assignment {
  id             String   @id @default(cuid())
  volunteerId    String
  shiftId        String
  roleId         String
  source         AssignmentSource @default(MANUAL)
  locked         Boolean  @default(false)
  checkedInAt    DateTime?
  noShow         Boolean  @default(false)
  absenceReason  AbsenceReason?
  absenceNote    String?  @db.Text
  confirmationStatus ConfirmationStatus @default(PENDING)
  confirmationAt DateTime?
  forceAssigned  Boolean  @default(false)
  overrideReason String?
  createdAt      DateTime @default(now())

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  shift     Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, shiftId, roleId])
  @@index([shiftId, roleId])
  @@index([volunteerId])
}

model RoleTarget {
  id        String   @id @default(cuid())
  shiftId   String
  roleId    String
  target    Int
  createdAt DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([shiftId, roleId])
}

// Scheduler note on a shift — visible to supervisors and admins.
model ShiftNote {
  id        String   @id @default(cuid())
  shiftId   String
  text      String   @db.Text
  author    String
  createdAt DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId, createdAt])
}

// Supervisor final-publish: locks the schedule for that shift and kicks off
// the communication workflow.
model SchedulePublish {
  id          String   @id @default(cuid())
  shiftId     String   @unique
  publishedBy String
  publishedAt DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
}

// Hall daily attendance log — light-touch, no hard scheduling.
model HallAttendance {
  id        String   @id @default(cuid())
  date      DateTime
  name      String
  groupSize Int      @default(1)
  activity  String
  hours     Float    @default(0)
  notes     String?
  author    String   @default("")
  createdAt DateTime @default(now())

  @@index([date])
}

// Every Communication-tab deploy (and automated sends) gets one row.
model MessageLog {
  id             String   @id @default(cuid())
  kind           String
  channel        String
  audience       String
  recipientCount Int
  errorCount     Int      @default(0)
  errors         String?  @db.Text
  subject        String?
  body           String   @db.Text
  sentBy         String
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actor       String
  action      String
  entityType  String
  entityId    String?
  shiftId     String?
  details     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([shiftId, createdAt])
}

// One row per reminder text sent, used to (a) dedupe so re-runs don't double-text
// and (b) route an inbound YES/NO reply to the right shift (latest reminder for
// that volunteer's phone).
model ReminderLog {
  id          String   @id @default(cuid())
  volunteerId String
  shiftId     String
  channel     String   @default("sms")
  providerSid String?
  createdAt   DateTime @default(now())

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  shift     Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([volunteerId, createdAt])
  @@index([shiftId])
}
